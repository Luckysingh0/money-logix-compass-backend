# ---- Server ----
PORT=5000
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173

# ---- Google Sign-In ----
# Must match frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- MongoDB ----
# Local: mongodb://127.0.0.1:27017/niveshmitra
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/niveshmitra
MONGODB_URI=mongodb://127.0.0.1:27017/niveshmitra

# ---- Groq (https://console.groq.com/keys) ----
# Keep this key in backend/.env only. Never expose it in the frontend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000
GROQ_MAX_TOKENS=2048

# Set to "true" to force canned responses without calling Groq (demo fallback).
# If GROQ_API_KEY is empty, mock mode turns on automatically.
MOCK_LLM=false
